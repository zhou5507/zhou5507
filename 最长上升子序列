#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main(){
    int n{0};
    cin>>n;
    vector<int>A(n,0);
    for(int i{0};i<n;i++){
        cin>>A[i];
    }
    vector<int>dp(n,0);
    for(int i{0};i<n;i++){
        for(int j{0};j<i;j++){
            if(A[j]<A[i])dp[i]=max(dp[i],dp[j]+1);
        }
    }
    int m{0};
    for(int i{0};i<n;i++){
        if(m<dp[i])m=dp[i];
    }
    cout<<m+1<<endl;
}
