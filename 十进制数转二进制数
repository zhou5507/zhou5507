#include <iostream>
#include <string>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    string s;
    if (!(cin >> s)) return 0;

    // 特判 0 的情况
    if (s == "0") {
        cout << 0 << endl;
        return 0;
    }

    // 将字符串形式的大数存入 vector，每个元素存一位数字
    vector<int> nums;
    for (char c : s) {
        nums.push_back(c - '0');
    }

    string res = ""; // 存储最终生成的二进制位（从低到高）

    // 只要被除数还不为 0，就继续除以 2
    while (!nums.empty()) {
        int remainder = 0; // 每一轮开始时，余数清零
        vector<int> next_nums; // 暂存这一轮除法产生的新商

        for (int i = 0; i < nums.size(); i++) {
            // 当前位 = 上一位的余数 * 10 + 这一位原本的数字
            int current = nums[i] + remainder * 10;
            
            // 计算商，存入新商序列
            next_nums.push_back(current / 2);
            
            // 计算余数，传给下一位
            remainder = current % 2;
        }

        // 这一轮最后剩下的余数，就是当前的二进制位
        res += (remainder + '0');

        // 去掉新商前面的 0（例如 06 变成 6）
        int pos = 0;
        while (pos < next_nums.size() && next_nums[pos] == 0) {
            pos++;
        }

        // 更新被除数，为下一轮除法做准备
        nums.clear();
        for (int i = pos; i < next_nums.size(); i++) {
            nums.push_back(next_nums[i]);
        }
    }

    // 因为我们是先算出低位的，所以需要反转字符串
    reverse(res.begin(), res.end());

    cout << res << endl;

    return 0;
}
