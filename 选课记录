#include <iostream>
#include <string>
#include <vector>
using namespace std;
int main() {
    string a, b;
    vector<string> A, B;
    while (getline(cin, a, ':')) {
        getline(cin, b);
        size_t p = b.find(":W");
        if (p != string::npos) {
            string n = b.substr(0, p);
            for (int i = 0; i < B.size(); i++) {
                if (B[i] == n && A[i] == a) {
                    B.erase(B.begin() + i);
                    A.erase(A.begin() + i);
                    break;
                }
            }
        } else {
            A.push_back(a);
            B.push_back(b);
        }
    }
    string r;
    int m = 0;
    for (int i = 0; i < B.size(); i++) {
        int c = 0;
        for (int j = 0; j < B.size(); j++) {
            if (B[j] == B[i]) c++;
        }
        if (c > m) {
            m = c;
            r = B[i];
        }
    }
    cout << r << endl;
    return 0;
}
