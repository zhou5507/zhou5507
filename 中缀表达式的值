#include <iostream>
#include <string>
#include <sstream>
#include <stack>
#include <vector>
#include <algorithm>
#include <iomanip>
#include <cstdlib>
using namespace std;
int main(){
    int n{0};
    cin>>n;
    cin.ignore();
    for(int i=0;i<n;i++){
        string l;
        if(getline(cin,l)){
            stack<int>s1;
            stack<char>s2;    
            for(int i=0;i<l.size();i++){
                char c=l[i];
                if(c<='9'&&c>='0'){
                    int c1=c-'0';
                    while(i+1<l.size()&&l[i+1]<='9'&&l[i+1]>='0'){
                        c1=c1*10+l[i+1]-'0';
                        i++;
                    }
                    s1.push(c1);
                }
                else if(c=='*'||c=='/'){
                    while(!s2.empty()&&(s2.top()=='*'||s2.top()=='/')){
                        char c2=s2.top();
                        s2.pop();
                        int a=s1.top();
                        s1.pop();
                        int b=s1.top();
                        s1.pop();
                        if(c2=='+') s1.push(a+b);
                        else if(c2=='-') s1.push(b-a);
                        else if(c2=='*') s1.push(a*b);
                        else if(c2=='/') s1.push(b/a);
                    }
                    s2.push(c);
                }
                else if(c=='+'||c=='-'){
                    while(!s2.empty()&&(s2.top()=='*'||s2.top()=='/'||s2.top()=='+'||s2.top()=='-')){
                        char c2=s2.top();
                        s2.pop();
                        int a=s1.top();
                        s1.pop();
                        int b=s1.top();
                        s1.pop();
                        if(c2=='+') s1.push(a+b);
                        else if(c2=='-') s1.push(b-a);
                        else if(c2=='*') s1.push(a*b);
                        else if(c2=='/') s1.push(b/a);
                    }
                    s2.push(c);
                }
                else if(c=='('){
                    s2.push(c);
                }
                else if(c==')'){
                    while(!s2.empty()&&s2.top()!='('){
                        char c2=s2.top();
                        s2.pop();
                        int a=s1.top();
                        s1.pop();
                        int b=s1.top();
                        s1.pop();
                        if(c2=='+') s1.push(a+b);
                        else if(c2=='-') s1.push(b-a);
                        else if(c2=='*') s1.push(a*b);
                        else if(c2=='/') s1.push(b/a);
                    }
                    s2.pop();
                }
            }
            while(!s2.empty()){
                char c2=s2.top();
                s2.pop();
                int a=s1.top();
                s1.pop();
                int b=s1.top();
                s1.pop();
                if(c2=='+') s1.push(a+b);
                else if(c2=='-') s1.push(b-a);
                else if(c2=='*') s1.push(a*b);
                else if(c2=='/') s1.push(b/a);
            }
            int result=s1.top();
            cout<<result<<endl;
        }
    }
}
